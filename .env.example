# ClipSync Server Configuration

# Server Network Settings
PORT=8787
HOST=0.0.0.0
SERVER_ORIGIN=http://localhost:8787

# PostgreSQL Database (Optional for dev: server falls back to embedded file storage if empty)
# DATABASE_URL=postgres://clipsync:clipsync_secure_password@localhost:5432/clipsync

# Object Storage for Encrypted Images & Files (Optional for dev: falls back to local disk storage)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=clipsync-blobs
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=clipsync_minio_admin
# AWS_SECRET_ACCESS_KEY=clipsync_minio_secret_key

# Security & Pairing
CLIPSYNC_DEV_TOKEN=local-development-token

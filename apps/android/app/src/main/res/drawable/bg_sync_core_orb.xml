<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Soft Mint Halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2400F5A0" />
        </shape>
    </item>

    <!-- Outer Beveled Dark Rim with Subtle Mint Rim Light -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#1F2937" />
            <stroke
                android:width="1.2dp"
                android:color="#4800F5A0" />
        </shape>
    </item>

    <!-- Deep Charcoal Surface with Radial Depth -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="26dp"
                android:startColor="#1A2434"
                android:endColor="#0B0F19" />
            <stroke
                android:width="1dp"
                android:color="#1F2937" />
        </shape>
    </item>
</layer-list>
